# ──────────────────────────────────────────────────────
# Multi-LLM Orchestrator — Environment Configuration
# ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────

# ── LLM Provider API Keys (at least one required) ─────
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_API_KEY=your-google-ai-studio-key
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
XAI_API_KEY=xai-your-xai-key

# ── OpenRouter Optimizations (optional) ────────────────
# USE_JSON_SCHEMA_RESPONSES=true
# USE_MODEL_VARIANTS=true
# USE_NATIVE_FALLBACKS=true
# USE_PROVIDER_SORTING=true
# USE_RESPONSE_HEALING=true

# ── Server Configuration ───────────────────────────────
# PORT=8000
# HOST=0.0.0.0
# LOG_LEVEL=INFO
# ENVIRONMENT=development

# ── Orchestrator Defaults ──────────────────────────────
# DEFAULT_BUDGET_USD=8.00
# DEFAULT_MAX_TIME_SECONDS=5400
# MAX_CONCURRENCY=3
